# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_SITE_URL=https://labstoreonline.com

# Careers form: SMTP account used to send applications to admin@tayscientific.com.my
# Use your domain mailbox (cPanel/hosting mail), Google Workspace, Outlook 365, etc.
SMTP_HOST=mail.tayscientific.com.my
SMTP_PORT=465
SMTP_USER=careers@tayscientific.com.my
SMTP_PASS=YOUR-MAILBOX-PASSWORD
# Optional: custom sender, must be allowed by your mail server
# SMTP_FROM="Tay Scientific Careers <careers@tayscientific.com.my>"

# Quotation requests are emailed to company.quotationEmail (src/lib/company.ts).
# Optional: override it here without changing code
# QUOTATION_EMAIL=

# Service requests (Services page) go to company.serviceEmail (service@tayscientific.com.my).
# Optional: override it here, e.g. your own Gmail while testing
# SERVICE_EMAIL=darwisyahliana@gmail.com
#
# Testing with Gmail instead of the company mailbox:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=darwisyahliana@gmail.com
# SMTP_PASS=your-16-letter-app-password   (Google Account → Security → 2-Step Verification → App passwords)

# Calibration due reminders (Admin -> Services -> Calibration log)
# Copy of every reminder goes here (default in src/lib/company.ts: calibrationReminderEmail)
# CALIBRATION_REMINDER_EMAIL=service@tayscientific.com.my
# For the automatic daily reminder on Vercel (vercel.json "crons"):
#  - CRON_SECRET: any long random text; Vercel sends it to the job automatically
#  - SUPABASE_SERVICE_ROLE_KEY: Supabase -> Project Settings -> API -> service_role key. SECRET: never share or commit it.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
